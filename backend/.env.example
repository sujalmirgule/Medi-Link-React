# =============================================================================
# MediLink Backend Environment Variables
# Copy to .env for local development. Never commit real production secrets.
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/medilink?schema=public"

# JWT Authentication Configuration
# MUST be set to a cryptographically secure random string in production
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="medilink-api"

# Allowed Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"

# Development Initial Admin Seed Credentials
DEV_ADMIN_EMAIL="admin@medilink.com"
DEV_ADMIN_PASSWORD="Admin@MediLink2026"

# AI Assistant Configuration
AI_PROVIDER="internal"
AI_API_KEY=""
