{
  "name": "medilink-backend",
  "version": "1.0.0",
  "description": "MediLink — Backend API Server",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:auth": "tsx src/scripts/test-auth.ts",
    "test:admin": "tsx src/scripts/test-admin.ts",
    "test:pharmacy": "tsx src/scripts/test-pharmacy.ts",
    "test:orders": "tsx src/scripts/test-orders.ts",
    "test:delivery": "tsx src/scripts/test-delivery.ts",
    "test:phase11": "tsx src/scripts/test-phase11.ts",
    "test:phase12": "tsx src/scripts/test-phase12.ts",
    "test:phase13": "tsx src/scripts/test-phase13-e2e.ts",
    "test:phase14": "tsx src/scripts/test-phase14-security.ts",
    "test:all": "npm run test:auth && npm run test:admin && npm run test:pharmacy && npm run test:orders && npm run test:delivery && npm run test:phase11 && npm run test:phase12 && npm run test:phase13 && npm run test:phase14",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
