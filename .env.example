# MediLink Environment Configuration Template
# Copy this file to .env for local development

NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/medilink?schema=public"

# Authentication Secrets (Phase 3 Foundation)
JWT_SECRET="replace-this-with-a-secure-random-secret-in-local-env"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"
